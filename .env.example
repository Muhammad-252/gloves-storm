# =========================================================
# GLOVES STORM — ENVIRONMENT VARIABLES TEMPLATE
# =========================================================

# Supabase Project URL (From Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Client-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Production Site URL
NEXT_PUBLIC_SITE_URL=https://glovesstorm.com

# Email Notifications (Every form inquiry submitted to glovesstorm@gmail.com)
NOTIFICATION_EMAIL=glovesstorm@gmail.com
# Gmail SMTP / Standard SMTP Configuration:
# To generate a Gmail App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USER=glovesstorm@gmail.com
SMTP_PASS=
# Optional custom host settings:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Instagram Live Feed Integration (Optional - can also be configured in Admin Settings)
INSTAGRAM_ACCESS_TOKEN=
